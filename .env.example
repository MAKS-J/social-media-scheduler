# Database
DATABASE_URL="postgresql://user:password@localhost:5432/socialflow_28"
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# Next.js
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="development"

# AWS S3 / S3-Compatible Storage
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="socialflow-28-dev"
AWS_S3_ENDPOINT="https://s3.amazonaws.com" # or http://localhost:9000 for MinIO

# Google OAuth (for Google Drive and Sheets)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Instagram Graph API
INSTAGRAM_APP_ID="your-instagram-app-id"
INSTAGRAM_APP_SECRET="your-instagram-app-secret"
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/auth/instagram/callback"

# Facebook Graph API
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/auth/facebook/callback"

# LinkedIn API
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/auth/linkedin/callback"

# X / Twitter API v2
X_API_KEY="your-x-api-key"
X_API_SECRET="your-x-api-secret"
X_BEARER_TOKEN="your-x-bearer-token"
X_REDIRECT_URI="http://localhost:3000/api/auth/x/callback"

# YouTube API
YOUTUBE_API_KEY="your-youtube-api-key"
YOUTUBE_CLIENT_ID="your-youtube-client-id"
YOUTUBE_CLIENT_SECRET="your-youtube-client-secret"
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/auth/youtube/callback"

# Email (for notifications and password reset)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@socialflow28.com"

# Logging
LOG_LEVEL="info"

# Security
ENCRYPTION_KEY="your-encryption-key-for-oauth-tokens"

# Feature Flags
ENABLE_APPROVALS_WORKFLOW="false"
ENABLE_ANALYTICS="true"
ENABLE_ADMIN_PANEL="true"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_HEAVY_MAX_REQUESTS=100
